# متغیرهای محیطی نمونه — این فایل را کپی کن به .env و مقادیر را پر کن
# نکته: این فایل در .gitignore است و به گیت‌هاب push نمی‌شود

# توکن بات تلگرام (الزامی) — از @BotFather بگیر
TELEGRAM_BOT_TOKEN=your_bot_token_here

# سقف حجم فایل قابل ارسال به مگابایت (اختیاری، پیش‌فرض ۵۰)
# بات‌های معمولی تلگرام نمی‌توانند فایل‌های بزرگتر از ۵۰ مگابایت بفرستند
MAX_TELEGRAM_MB=50